APP_ENV=development
LOG_LEVEL=INFO

# Development defaults to local SQLite.
# Production must use PostgreSQL.
DATABASE_URL=sqlite:///./llmbastion.db

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Development: memory
# Production: redis (unless explicitly overridden)
RATE_LIMIT_BACKEND=memory
REDIS_URL=

MAX_REQUEST_BODY_BYTES=32768
