APP_ENV=development
LOG_LEVEL=INFO

# Development defaults to local SQLite.
# Production must use PostgreSQL.
DATABASE_URL=sqlite:///./llmbastion.db

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Per-network-phase timeout, not a total request deadline.
GROQ_TIMEOUT_SECONDS=20
# 0 prevents automatic duplicate generations. Explicit overrides: 0..2.
GROQ_MAX_RETRIES=0
# Total async provider operation budget, including retries/backoff (Python 3.11+).
GROQ_TOTAL_DEADLINE_SECONDS=20
# Per-process active operations and bounded waiting queue (0 disables waiting).
GROQ_MAX_CONCURRENT_REQUESTS=4
GROQ_MAX_QUEUED_REQUESTS=16

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Development: memory
# Production: redis (unless explicitly overridden)
RATE_LIMIT_BACKEND=memory
REDIS_URL=

MAX_REQUEST_BODY_BYTES=32768
